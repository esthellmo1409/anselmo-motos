# ---------------------------------------------------------------
# Anselmo Motos — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA commite o .env.local.
# ---------------------------------------------------------------

# URL pública do site (SEO, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.anselmomotos.com.br

# Painel /admin (proteção básica). Troque por uma senha forte.
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# ---------- IA (somente servidor) ----------
# Sem chave, o atendimento funciona no modo de regras (respostas da tabela + FAQ).
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# ---------- WhatsApp Cloud API (Meta) ----------
# Deixe vazio até conectar. Sem token, as mensagens são apenas registradas no log.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=um-token-qualquer-para-verificar-o-webhook

# Números dos vendedores que recebem o resumo do lead (DDI+DDD+número, separados por vírgula)
SELLER_WHATSAPP_NUMBERS=5599000000000
